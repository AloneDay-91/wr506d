# Configuration de production
# Copier ce fichier et définir ces variables dans Dokploy

# APP_SECRET - Génère une clé aléatoire sécurisée (32+ caractères hex)
APP_SECRET=your_random_secret_key_here

# DATABASE_URL - URL de connexion MySQL
DATABASE_URL=mysql://admin:password@host:3306/database

# MESSENGER (optionnel, doctrine par défaut)
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# MAILER (optionnel, null par défaut)
MAILER_DSN=null://null

# CORS (optionnel, à adapter selon tes besoins)
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# JWT (utilise les valeurs de ton .env si elles existent)
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=your_jwt_passphrase_here